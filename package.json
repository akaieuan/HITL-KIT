{
  "name": "hitl-kit",
  "version": "0.6.3",
  "private": true,
  "description": "Workspace manager for the @hitl-kit/* npm packages — human-in-the-loop primitives for agentic UIs.",
  "scripts": {
    "packages:build": "pnpm --filter '@hitl-kit/*' build",
    "packages:typecheck": "pnpm --filter '@hitl-kit/*' typecheck",
    "build": "pnpm packages:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:publish": "node scripts/publish-smoke.mjs",
    "check:readme": "node scripts/readme-check.mjs",
    "api:check": "pnpm packages:build && node scripts/api-surface.mjs --check",
    "api:update": "pnpm packages:build && node scripts/api-surface.mjs",
    "registry:check": "pnpm --filter @hitl-kit/ui registry:check",
    "verify": "pnpm packages:build && pnpm packages:typecheck && pnpm test && pnpm registry:check"
  },
  "devDependencies": {
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=4.1.3",
      "hono": "^4.12.34",
      "langsmith": "^0.6.0",
      "postcss": ">=8.5.18",
      "ip-address": ">=10.3.1",
      "brace-expansion": "^2.1.2",
      "qs": "^6.16.0",
      "sharp": ">=0.35.0",
      "browserslist": ">=4.28.7",
      "nanoid@3": ">=3.3.18",
      "@hono/node-server": ">=1.19.15",
      "body-parser": ">=2.3.0",
      "esbuild": ">=0.28.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  }
}

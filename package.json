{
  "name": "hitl-kit",
  "version": "0.6.3",
  "private": true,
  "description": "Workspace manager for the @hitl-kit/* npm packages — human-in-the-loop primitives for agentic UIs.",
  "scripts": {
    "packages:build": "pnpm --filter '@hitl-kit/*' build",
    "packages:typecheck": "pnpm --filter '@hitl-kit/*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm packages:build && pnpm packages:typecheck && pnpm test"
  },
  "devDependencies": {
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.2",
      "hono": "^4.12.25",
      "langsmith": "^0.6.0",
      "postcss": "^8.5.10",
      "ip-address": "^10.1.1",
      "brace-expansion": "^5.0.6",
      "qs": "^6.15.2"
    }
  }
}
